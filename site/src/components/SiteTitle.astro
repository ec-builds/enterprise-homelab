---
import { Image } from 'astro:assets';
import logo from '../assets/ec-logo.png';
---

<a href="/" class="ec-title">
  <Image src={logo} alt="" width={40} height={40} densities={[1, 2]} loading="eager" />
  <span class="word">EC-<span>BUILDS</span></span>
</a>

<style>
  .ec-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .word {
    font-family: var(--ec-font-display);
    font-weight: 800;
    font-size: 1.2rem;
    letter-spacing: 0.01em;
    color: var(--sl-color-white);
  }
  .word span {
    color: var(--sl-color-accent);
  }
</style>
