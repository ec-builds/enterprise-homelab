# SNMP Exporter environment variables
#
# Provides SNMPv3 authentication and privacy credentials to SNMP Exporter.
# These variables are referenced by the custom SNMP authentication
# configuration and expanded when the container starts.
#
# Replace the placeholder values with the credentials configured on the
# monitored network device.
#
# SECURITY:
# Do not commit a .env file containing real credentials to version control.
# Add .env to .gitignore and use a sanitized .env.example for documentation.

# SNMPv3 authentication password
SNMP_AUTH_PASSWORD=<insert-auth-password>

# SNMPv3 privacy/encryption password
SNMP_PRIV_PASSWORD=<insert-privacy-password>
