/* =========================================================
   EC-Builds Homelab Status
   Uptime Kuma Custom CSS
   ========================================================= */


/* ---------- PAGE WIDTH ---------- */

/* Give desktop monitors more horizontal room */
.container {
    max-width: 1180px !important;
}


/* ---------- HEADER ---------- */

/* Main status-page title */
h1 {
    font-weight: 700 !important;
    letter-spacing: -0.02em;
}


/* ---------- EC-BUILDS HEADER BANNER ---------- */

/* Logo + title banner */
h1.title-flex {
    background: linear-gradient(
        135deg,
        #0b4f8a 0%,
        #1479bd 55%,
        #28a5d8 100%
    ) !important;

    color: #ffffff !important;

    padding: 22px 26px !important;
    border-radius: 16px !important;
    margin-bottom: 22px !important;

    /* Subtle glass-style border */
    border: 1px solid rgba(255, 255, 255, 0.28) !important;

    box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.20),
        0 4px 12px rgba(0, 0, 0, 0.08),
        0 10px 28px rgba(0, 0, 0, 0.05) !important;
}

/* Force title text white */
h1.title-flex span {
    color: #ffffff !important;
}

/* Keep EC-Builds logo clean against blue banner */
h1.title-flex .logo {
    background: #ffffff !important;
    border-radius: 50% !important;
    padding: 4px !important;

    box-shadow:
        0 2px 8px rgba(0, 0, 0, 0.10),
        inset 0 0 0 1px rgba(255, 255, 255, 0.40) !important;
}


/* ---------- ACTION BUTTONS ---------- */

/* Keep navigation controls aligned with EC-Builds branding */
.btn-primary {
    background: #1479bd !important;
    border-color: #1479bd !important;
    color: #ffffff !important;

    border-radius: 999px !important;

    box-shadow:
        0 2px 6px rgba(0, 0, 0, 0.06) !important;

    transition:
        transform 0.15s ease,
        background-color 0.15s ease,
        border-color 0.15s ease,
        box-shadow 0.15s ease !important;
}

.btn-primary:hover {
    background: #0b4f8a !important;
    border-color: #0b4f8a !important;

    transform: translateY(-1px);

    box-shadow:
        0 4px 10px rgba(0, 0, 0, 0.08) !important;
}

.btn-primary:active {
    transform: translateY(0);
}


/* ---------- OVERALL STATUS ---------- */

/* Main "All Systems Operational" card */
.overall-status {
    border-radius: 14px !important;
    padding: 22px 26px !important;
    margin-bottom: 24px !important;
}


/* ---------- GROUP HEADINGS ---------- */

/*
   Group banners are intentionally more understated
   than the main EC-Builds header.
*/
.group-title {
    font-weight: 700 !important;
    letter-spacing: -0.01em;

    background: linear-gradient(
        135deg,
        #0b4f8a 0%,
        #1479bd 100%
    ) !important;

    color: #ffffff !important;

    padding: 9px 15px !important;
    border-radius: 10px !important;

    margin-top: 24px !important;
    margin-bottom: 10px !important;

    border: 1px solid rgba(255, 255, 255, 0.18) !important;

    box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.12),
        0 2px 6px rgba(0, 0, 0, 0.05) !important;
}

/* Force group title text and icons white */
.group-title * {
    color: #ffffff !important;
}


/* ---------- SERVICE CARDS ---------- */

/* Main monitor group containers */
.shadow-box {
    border-radius: 14px !important;

    /* Intentionally subtle to avoid excessive layering */
    box-shadow:
        0 2px 6px rgba(0, 0, 0, 0.035),
        0 6px 18px rgba(0, 0, 0, 0.025) !important;
}

/* Tighter spacing between monitor groups */
.group {
    margin-bottom: 22px !important;
}


/* ---------- MONITOR ROWS ---------- */

/* Individual monitor rows */
.monitor-list .item {
    padding-top: 11px !important;
    padding-bottom: 11px !important;

    /* Thin enterprise-style healthy status accent */
    border-left: 3px solid rgba(34, 197, 94, 0.85) !important;

    transition:
        transform 0.15s ease,
        background-color 0.15s ease,
        box-shadow 0.15s ease,
        border-color 0.15s ease !important;
}

/* Hover interaction */
.monitor-list .item:hover {
    transform: translateY(-1px);

    background-color: rgba(20, 121, 189, 0.035) !important;

    box-shadow:
        0 3px 10px rgba(0, 0, 0, 0.04),
        0 6px 18px rgba(0, 0, 0, 0.025) !important;
}

/* Monitor names */
.item-name {
    font-weight: 600 !important;
    letter-spacing: -0.005em;
}


/* ---------- STATUS INDICATORS ---------- */

/* Subtle pulse for operational status indicators */
@keyframes ec-status-pulse {

    0% {
        box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.35);
    }

    70% {
        box-shadow: 0 0 0 5px rgba(34, 197, 94, 0);
    }

    100% {
        box-shadow: 0 0 0 0 rgba(34, 197, 94, 0);
    }
}

/*
   Apply a restrained pulse to active indicators.
   Animation remains intentionally slow and subtle.
*/
.status.active,
.status-maintenance.active,
.bg-primary {
    animation: ec-status-pulse 2.8s ease-out infinite;
}


/* ---------- UPTIME PERCENTAGE ---------- */

/* Availability badge pills */
.badge {
    font-weight: 600 !important;

    border-radius: 999px !important;
    padding: 5px 9px !important;

    border: 1px solid rgba(0, 0, 0, 0.05) !important;

    box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.25),
        0 1px 3px rgba(0, 0, 0, 0.04) !important;
}


/* ---------- DESCRIPTION ---------- */

/* Improve readability of status-page description */
.description {
    line-height: 1.6 !important;
    margin-top: 18px !important;
    margin-bottom: 22px !important;
}


/* ---------- FOOTER ---------- */

footer {
    opacity: 0.65;
    font-size: 0.875rem !important;
    margin-top: 32px !important;
}


/* ---------- ACCESSIBILITY ---------- */

/* Respect reduced-motion preferences */
@media (prefers-reduced-motion: reduce) {

    .status.active,
    .status-maintenance.active,
    .bg-primary {
        animation: none !important;
    }

    .monitor-list .item {
        transition: none !important;
    }

    .monitor-list .item:hover {
        transform: none !important;
    }

    .btn-primary {
        transition: none !important;
    }

    .btn-primary:hover {
        transform: none !important;
    }
}


/* ---------- MOBILE ---------- */

@media (max-width: 768px) {

    .container {
        padding-left: 14px !important;
        padding-right: 14px !important;
    }

    h1 {
        font-size: 1.8rem !important;
    }

    /* Header banner */
    h1.title-flex {
        padding: 18px 20px !important;
        border-radius: 12px !important;
        margin-bottom: 18px !important;
    }

    /* Logo */
    h1.title-flex .logo {
        padding: 3px !important;
    }

    /* Overall status */
    .overall-status {
        padding: 18px !important;
    }

    /* Group banners */
    .group-title {
        padding: 8px 13px !important;
        border-radius: 9px !important;
        margin-top: 20px !important;
        margin-bottom: 9px !important;
    }

    /* Groups */
    .group {
        margin-bottom: 20px !important;
    }

    /* Cards */
    .shadow-box {
        border-radius: 12px !important;
    }

    /* Monitor rows */
    .monitor-list .item {
        padding-top: 9px !important;
        padding-bottom: 9px !important;
        border-left-width: 3px !important;
    }

    /* Disable hover lift on touch-sized displays */
    .monitor-list .item:hover {
        transform: none !important;
    }

    /* Slightly smaller uptime pills */
    .badge {
        padding: 4px 8px !important;
    }

    /* Action buttons */
    .btn-primary:hover {
        transform: none !important;
    }
}
